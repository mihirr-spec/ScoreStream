# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB Atlas connection string (Atlas -> Connect -> Drivers)
MONGODB_URI=
# Name of the database inside the cluster
DB_NAME=judging_system

# Admin login. ADMIN_USERNAME is optional (defaults to "admin"); ADMIN_PASSWORD has no default.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Long random string used to sign login tokens
JWT_SECRET=

# AI feedback (OpenRouter). Leave AI_API_KEY empty to use the offline MOCK feedback.
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Used if AI_MODEL fails twice (rate limit, bad JSON, model down). Leave empty to skip.
AI_FALLBACK_MODEL=google/gemma-4-31b-it:free

# Port the Express server listens on
PORT=3000
