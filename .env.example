# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB Atlas connection string (Atlas -> Connect -> Drivers)
MONGODB_URI=
# Name of the database inside the cluster
DB_NAME=judging_system

# Admin login. ADMIN_USERNAME is optional (defaults to "admin"); ADMIN_PASSWORD has no default.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Long random string used to sign login tokens
JWT_SECRET=

# AI feedback (OpenRouter). Leave AI_API_KEY empty to use the offline MOCK feedback.
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Used if AI_MODEL fails twice (rate limit, bad JSON, model down). Leave empty to skip.
AI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Optional: a different provider for the fallback (here Google Gemini, free key from aistudio.google.com).
# Leave both empty to use AI_BASE_URL / AI_API_KEY for the fallback as well.
AI_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_FALLBACK_API_KEY=

# Port the Express server listens on
PORT=3000
